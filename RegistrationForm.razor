@inject EventEase.Services.UserSessionService SessionService

<div class="registration-form">
    <h2>User Registration</h2>

    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">Full Name</label>
            <InputText id="name" @bind-Value="model.Name" class="form-control" />
            <ValidationMessage For="@(() => model.Name)" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="model.Email" class="form-control" />
            <ValidationMessage For="@(() => model.Email)" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="model.Password" class="form-control" />
            <ValidationMessage For="@(() => model.Password)" />
        </div>

        <button type="submit" class="btn">Register</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <p class="success">@successMessage</p>
    }
</div>

@code {
    private RegistrationModel model = new();
    private string successMessage = string.Empty;

    private void HandleValidSubmit()
    {
        // State management: save user session
        SessionService.Login(model.Name, model.Email);
        successMessage = $"Welcome, {model.Name}! You are now registered.";
        model = new RegistrationModel();
    }

    public class RegistrationModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Name is required")]
        [System.ComponentModel.DataAnnotations.MinLength(2, ErrorMessage = "Name must be at least 2 characters")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;
    }
}
