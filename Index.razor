@page "/"

<PageTitle>EventEase - Home</PageTitle>

<div class="home">
    <h1>Welcome to EventEase</h1>
    <p>Discover and manage events easily with our Blazor-powered platform.</p>

    <div class="features">
        <div class="feature-card">
            <h3>Event Cards</h3>
            <p>Browse events with two-way data binding and real-time updates.</p>
        </div>
